{
  "name": "@dsh-external/dsh-agent-board",
  "version": "0.2.0",
  "description": "Agent 实时看板：子代理停滞检测器（自动 notice 提醒）+ 树形看板（悬浮窗/停靠右侧面板双形态，可切换/并存/设置开关）",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "BSD-3-Clause",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "deepseek-harness",
    "agent-board",
    "subagent",
    "monitoring",
    "dashboard"
  ],
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-host-webserver": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-locale": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.0.1-rc <2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
